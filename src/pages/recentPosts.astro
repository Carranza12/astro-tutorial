<section class="recent-posts">
  <h2 class="h2-post">Publicaciones recientes</h2>
  <div class="posts-container">
    {
      posts.map((post) => (
        <article class="post">
          <img src={post.image} alt={post.title} class="post-image" />
          <div class="post-content">
            <h3 class="post-title">
              <a href={post.href}>{post.title}</a>
            </h3>
            <p class="post-date">{post.date}</p>
            <p class="post-author">Por {post.author}</p>
            <p class="post-description">{post.description}</p>
            <div class="post-categories">
              {post.categories.map((category) => (
                <span class="category">{category}</span>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  a{
    text-decoration: none;
    color: black;
  }
  a:hover{
    color: #2F2E8B;
  }
  .recent-posts {
    padding: 1rem;
  }
  .posts-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 20px;
  }
  .post {
    display: flex;
    flex-direction: column;
    width: calc(50% - 10px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    border-radius: 8px;
    overflow: hidden;
  }
  .post-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }
  .post-content {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .post-title {
    font-size: 1.5rem;
    font-weight: bold;
    margin: 0;
  }
  .post-date,
  .post-author {
    color: #555;
    margin: 0;
  }
  .post-description {
    margin: 0;
  }
  .post-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .category {
    background-color: #eee;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
  }
  .h2-post {
    margin-bottom: 20px !important;
  }

  @media (max-width: 768px) {
    .post {
      width: 100%;
    }
  }
  @media (max-width: 576px) {
    .post-content {
      padding: 0.5rem;
    }
    .post-title {
      font-size: 1.25rem;
    }
    .post-image {
      height: 150px;
    }
  }
  .h2-post {
    text-align: center;
  }
</style>
