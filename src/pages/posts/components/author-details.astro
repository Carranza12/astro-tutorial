---
const { date } = Astro.props;
---

<style>
    .post-meta {
  display: flex;
  align-items: center;
  margin-bottom: 20px;
}
  .author-image {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    margin-right: 10px;
  }
  .author-details {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
  }
  .author-details h2 {
    font-weight: 400;
    font-size: 18px;
  }
  .post-date {
    color: #555;
  }
</style>
<div class="post-meta">
  <img
    src="https://media.licdn.com/dms/image/D5603AQHFUFta80RB-w/profile-displayphoto-shrink_800_800/0/1718215533790?e=1727913600&v=beta&t=E4j-PIg51PoEO0M4hWWNK313LRR_KSV0F3Pco2fN9g0"
    alt="Francisco Javier Carranza Esquivel"
    class="author-image"
  />
  <div class="author-details">
    <h2>Francisco Javier Carranza Esquivel</h2>
    <p>
      Desarrollador web TypeScript | Angular | Node.js | Nest.js | Google Cloud
    </p>
    <p class="post-date">{date}</p>
  </div>
</div>
