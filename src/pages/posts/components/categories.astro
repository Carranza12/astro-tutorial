---
const { categories } = Astro.props;
---

<style>
  .post-categories {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 20px;
  }
  .category {
    background-color: #eee;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
  }
</style>
<div class="post-categories">
  {categories.map((category) => <span class="category">{category}</span>)}
</div>
