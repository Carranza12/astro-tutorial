---
import "../../styles/menu.css";
import "../../global.css"
---
<div id="overlay"></div>
<header>
    <div class="menu-container">
      <div class="menu-left">
      <!--   <div class="menu-icon" id="menu-icon">&#9776;</div>  -->
      </div>
      <div class="menu-center">
        <h1 style="cursor: pointer;" onclick="window.open('/','_self')" class="logo">Carranza <span class="highlight">DEV</span></h1>
      </div>
      <div class="menu-right">
        <a target="_blank" href="https://www.facebook.com/carranza.code/">
          <img src="/assets/icons/facebook.svg" alt="Facebook" /></a>
        <a target="_blank" href="https://www.tiktok.com/@carranza.dev">
          <img src="/assets/icons/film.svg" alt="TikTok" /></a>
        <a target="_blank" href="https://www.linkedin.com/in/francisco-javier-carranza-esquivel-474836206/">
          <img src="/assets/icons/linkedin.svg" alt="LinkedIn" /></a>
        <a target="_blank" href="https://www.youtube.com/channel/UCBUjTIjWi8GRyDIKKaHtR2w">
          <img src="/assets/icons/youtube.svg" alt="YouTube" /></a>
      </div>
    </div>
    <nav class="mobile-menu" id="mobile-menu">
      <ul>
        <li><a href="#">Inicio</a></li>
        <li><a href="#">Publicaciones recientes</a></li>
        <li><a id="close">cerrar</a></li>
      </ul>
    </nav>
  </header>



  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const menuIcon = document.getElementById("menu-icon");
      const mobileMenu = document.getElementById("mobile-menu");
      const overlay = document.getElementById("overlay");
      const close = document.getElementById("close");
      const contentWrapper = document.getElementById("content-wrapper");

      menuIcon.addEventListener("click", function () {
        mobileMenu.classList.toggle("active");
        overlay.classList.toggle("active");
        contentWrapper.classList.toggle("overlay-active");
      });

      close.addEventListener("click", function () {
        console.log("click")
        mobileMenu.classList.remove("active");
        mobileMenu.classList.add("d-none")
        overlay.classList.remove("active");
        contentWrapper.classList.remove("overlay-active");
      });
    });
  </script>