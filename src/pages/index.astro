---
import "../styles/menu.css";
import "../global.css";
import RecentPosts from './recentPosts.astro';
import Toolbar from "./components/toolbar.astro"
---

<style>
  main {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
  }
  .header_section {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
    margin: 20px;
    height: 400px;
    padding-bottom: 40px;
  }
  .header_section p {
    text-align: center;
  }
  .header_section button {
    width: 200px;
  }
  h1, p {
    max-width: 600px;
    text-align: center;
  }
  @media (max-width: 768px) {
    .header_section, .header_section button {
      width: 90%;
    }
    .header_section {
      margin: 10px;
    }
  }
</style>

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Carranza DEV</title>
  </head>
  <body>
    <div id="content-wrapper">
      <Toolbar/>
      <main>
        <section class="header_section">
          <h1>
            Descubre y domina el desarrollo web con contenido especializado en frontend, backend y más.
          </h1>
          <p>
            He creado este blog para compartir mi conocimiento y aportar al mundo del desarrollo de software
          </p>
          <button type="button">Explorar</button>
        </section>

        <RecentPosts />
  
      </main>
    </div>
  </body>
</html>
