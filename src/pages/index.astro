---
import "../styles/menu.css";
import "../global.css";
import RecentPosts from './recentPosts.astro';
---

<style>
  main {
    width: calc(100vw - 40px);
    display: flex;
    justify-content: center;
    align-items: center;
    align-content: center;
    flex-direction: column;
    @media(max-width:1401px){
      width: 500px;
      margin: 0 auto;
    }
  }
  .header_section {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
    margin: 20px;
    height: 400px;
    padding-bottom: 40px;
  }
 
  .header_section p {
    text-align: center;
  }
  .header_section button {
    width: 500px;
  }
  h1, p{
    max-width: 600px;
    text-align: center;
  }

  @media(max-width: 602px){
    .header_section, button{
      margin: 30px;
      width: 400px!important;
    }
  }
</style>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Menu Example</title>
    <link rel="stylesheet" href="../styles/menu.css" />
  </head>
  <body>
    <div id="content-wrapper">
      <header>
        <div class="menu-container">
          <div class="menu-left">
            <div class="menu-icon" id="menu-icon">&#9776;</div>
          </div>
          <div class="menu-center">
            <h1 class="logo">Carranza <span class="highlight">DEV</span></h1>
          </div>
          <div class="menu-right">
            <a target="_blank" href="https://www.facebook.com/carranza.code/">
              <img src="../../public/assets/icons/facebook.svg" alt="" /></a
            >
            <a target="_blank" href="https://www.tiktok.com/@carranza.dev"
              ><img src="../../public/assets/icons/film.svg" alt="" /></a
            >
            <a
              target="_blank"
              href="https://www.linkedin.com/in/francisco-javier-carranza-esquivel-474836206/"
              ><img src="../../public/assets/icons/linkedin.svg" alt="" /></a
            >
            <a
              target="_blank"
              href="https://www.youtube.com/channel/UCBUjTIjWi8GRyDIKKaHtR2w"
              ><img src="../../public/assets/icons/youtube.svg" alt="" /></a
            >
          </div>
        </div>
        <nav class="mobile-menu" id="mobile-menu">
          <ul>
            <li><a href="#">Inicio</a></li>
            <li><a href="#">Publicaciones recientes</a></li>
            <li><a href="#">Todas las publicaciones</a></li>
          </ul>
        </nav>
      </header>
      <main>
        <section class="header_section">
          <h1>
            Descubre y domina el desarrollo web con contenido especializado en
            frontend, backend y más.
          </h1>
          <p>
            He creado este blog para compartir mi conocimiento y aportar al
            mundo del desarrollo de software
          </p>
          <button type="button">Explorar</button>
        </section>
        <RecentPosts />
      </main>
    </div>
    <div id="overlay"></div>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const menuIcon = document.getElementById("menu-icon");
        const mobileMenu = document.getElementById("mobile-menu");
        const overlay = document.getElementById("overlay");
        const contentWrapper = document.getElementById("content-wrapper");

        menuIcon.addEventListener("click", function () {
          mobileMenu.classList.toggle("active");
          overlay.classList.toggle("active");
          contentWrapper.classList.toggle("overlay-active");
        });

        overlay.addEventListener("click", function () {
          mobileMenu.classList.remove("active");
          overlay.classList.remove("active");
          contentWrapper.classList.remove("overlay-active");
        });
      });
    </script>
  </body>
</html>
