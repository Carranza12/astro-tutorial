---
const title = "Inicio de sesion"
import Toolbar from "../../pages/components/toolbar.astro"
import "../../global.css";
import "../../styles/menu.css";
---
<style>
  /* Estilos globales */
  body {
    font-family: 'Inter', sans-serif;
    background-color: #f4f4f9;
    color: #333;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* Estructura principal */
  main {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    padding: 20px;
  }

  /* Contenedor de autenticación */
  .container-auth {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 20px;
    max-width: 400px;
    background-color: #fff;
    border-radius: 10px;
    padding: 30px;
    box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
  }

  /* Título */
  h1 {
    font-size: 1.8rem;
    margin-bottom: 10px;
    color: #222;
    text-align: center;
  }

  /* Párrafo descriptivo */
  .p-auth {
    font-size: 1rem;
    color: #666;
    text-align: center;
    margin-bottom: 20px;
  }

  /* Estilo de los labels */
  label {
    display: block;
    font-weight: 600;
    margin-bottom: 5px;
  }

  /* Estilo de los inputs */
  input {
    width: 100%;
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 5px;
    font-size: 1rem;
    margin-bottom: 15px;
    transition: border-color 0.3s ease;
  }

  /* Estilo de los inputs al estar enfocados */
  input:focus {
    border-color: #2F2E8B;
    outline: none;
  }

  /* Estilo del botón de login */
  button {
    width: 100%;
    padding: 12px;
    background-color: #2F2E8B;
    border: none;
    border-radius: 5px;
    color: #fff;
    font-size: 1rem;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  /* Efecto hover en el botón */
  button:hover {
    background-color: #2F2E8B;
  }

  /* Estilo del texto del enlace */
  .text-link {
    color: #2563eb;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  /* Efecto hover en el enlace */
  .text-link:hover {
    color: #1d4ed8;
    text-decoration: underline;
  }

  /* Estilos responsivos */
  @media (max-width: 768px) {
    .container-auth {
      padding: 20px;
    }

    h1 {
      font-size: 1.5rem;
    }

    input {
      font-size: 0.9rem;
    }

    button {
      font-size: 0.9rem;
      padding: 10px;
    }
  }

  @media (max-width: 768px) {
    main{
        padding-left: 0px;
    }
  }
  @media (max-width: 481px) {
    .container-auth{
        width: 320px;
    }
    main{
        padding-right: 0px;
    }
  }
</style>

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <div id="content-wrapper">
      <Toolbar/>
      <main>
        <div class="container-auth">
          <h1>Inicia Sesión</h1>
          <p class="p-auth">Inicia sesión para comentar, dar me gusta y guardar tus posts favoritos.</p>
          <form>
            <label for="email">Correo Electrónico</label>
            <input type="email" id="email" required>
            
            <label for="password">Contraseña</label>
            <input type="password" id="password" required>
            
            <button type="submit">Entrar</button>
          </form>
          <p class="text-center">¿No tienes una cuenta? <a href="/auth/register" class="text-link">Crear cuenta</a></p>
        </div>
      </main>
    </div>
  </body>
</html>
